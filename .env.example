# ============================================================================
# PhuQuocHub — biến môi trường mẫu (Sprint 0)
# Copy sang `.env` rồi chỉnh giá trị. KHÔNG commit `.env`.
# ============================================================================

# --- Chung ---
NODE_ENV=development

# --- API (NestJS) ---
API_PORT=4000
API_GLOBAL_PREFIX=api
# Origin mà TRÌNH DUYỆT gọi được tới API này (khác API_PORT — cái đó chỉ là cổng bind cục bộ). Dùng
# để dựng URL media tuyệt đối trả cho client (`{API_PUBLIC_URL}/{API_GLOBAL_PREFIX}/media/{id}/file`,
# Secure Private Media 2026-08-10). Production PHẢI đặt origin thật: API_PUBLIC_URL=https://phuquochub.com
API_PUBLIC_URL=http://localhost:4000

# --- Database (PostgreSQL + PostGIS) ---
# Khớp docker-compose.yml
DATABASE_URL=postgresql://phuquoc:phuquoc@localhost:5432/phuquochub
DB_HOST=localhost
DB_PORT=5432
DB_USER=phuquoc
DB_PASSWORD=phuquoc
DB_NAME=phuquochub
DB_SSL=false
# Chỉ bật ở dev; production dùng migration
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# PLACE-038: chỉ dùng cho docker-compose.prod.yml (dev compose không đặt mật khẩu Redis).
# Khi có giá trị, REDIS_URL production PHẢI nhúng nó: redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=

# --- Object storage (MinIO / S3-compatible) — Media Upload Foundation ---
# PRODUCTION PHẢI đặt origin CÔNG KHAI, KHÔNG phải tên service nội bộ:
#   S3_ENDPOINT=https://media.phuquochub.com
# Lý do (Secure Private Media, 87d010e) — đây là cấu hình DỄ SAI NHẤT của cả stack:
# SigV4 ký CẢ Host header. Mọi presigned URL (GET lúc xem ảnh, PUT lúc upload) được ký cho đúng
# origin ghi ở biến này, rồi giao thẳng cho TRÌNH DUYỆT đi lấy. Đặt `http://minio:9000` ở đây thì
# URL ký ra trỏ vào tên service chỉ tồn tại trong mạng Docker — trình duyệt không phân giải nổi, và
# mọi ảnh/upload hỏng im lặng (API vẫn 302 bình thường, chỉ là 302 tới một host không tồn tại).
# `media.phuquochub.com` được Caddy proxy vào `minio:9000` và GIỮ NGUYÊN Host header, nên chữ ký
# khớp — xem infrastructure/caddy/Caddyfile.
# Hệ quả: container `api` cũng gọi HeadObject/GetObject qua origin công khai này (hairpin qua Caddy),
# chứ không đi tắt qua mạng nội bộ. Đây là đánh đổi CÓ CHỦ Ý để chỉ có MỘT origin được ký.
S3_ENDPOINT=http://localhost:9000
# Dev default below (`minioadmin`) IS the MinIO root credential — fine for local `docker compose up`
# where nothing else depends on it. PRODUCTION MUST NEVER use the root credential here: create a
# dedicated least-privilege MinIO user (GetObject/PutObject/DeleteObject only, NO ListBucket) and
# point these two vars at it instead. Root stays administrative-only (bucket policy/IAM/console).
# See docs/data/modules/media.md §13.8 (IAM model) and §13.9 (rotation runbook).
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Bucket is environment-configurable via this var (production points it at the real R2/S3
# bucket). Leave UNSET for local dev/test — the app computes a safe per-environment default
# itself (phuquochub-dev outside NODE_ENV=test, phuquochub-test when NODE_ENV=test) so tests can
# never silently run against the dev bucket. Only set this explicitly for production.
S3_BUCKET=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# KHÔNG CÒN DÙNG cho URL media (Secure Private Media, 2026-08-10). Trước đây đây là origin đọc
# công khai của bucket — mô hình đó đòi bucket mở anonymous read cho TOÀN BỘ object, làm lộ cả media
# pending/hidden/rejected. Client nay nhận URL API (`/api/media/{id}/file`) redirect tới signed URL
# ngắn hạn, nên KHÔNG code path nào cần origin này đọc được ẩn danh. Giữ biến để không phá validation
# của deployment đã đặt sẵn; để trống là an toàn.
S3_PUBLIC_URL=
# Tuổi thọ (giây) của presigned GET URL phát media. Ngắn có chủ ý — đây là thứ DUY NHẤT chặn giữa
# một URL bị lộ và bytes của object. Hợp lệ 30..3600, mặc định 300.
S3_PRESIGN_GET_TTL=300

# --- Backup offsite destination (PLACE-037/038 — Owner-approved: Cloudflare R2) ---
# CHỈ dùng bởi scripts/sync-offsite.sh (chạy trên VPS thật qua cron, KHÔNG chạy trong session
# này — không có credential R2 thật ở đây). Để trống = sync bị bỏ qua an toàn (backup cục bộ
# vẫn chạy bình thường qua scripts/backup.sh, không phụ thuộc các biến này).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Auth (dùng từ Sprint 1) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Web (Next.js) ---
# PLACE-038: cho `npm run dev`/`next build` chạy trực tiếp trên máy, biến này đọc lúc build như
# bình thường. Với apps/web/Dockerfile, biến NEXT_PUBLIC_ được Next.js nhúng cứng lúc BUILD —
# phải truyền qua `docker build --build-arg NEXT_PUBLIC_API_URL=...` (docker-compose.prod.yml
# đã làm việc này qua build.args, đọc đúng biến này), KHÔNG phải qua `environment:` lúc chạy.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Domain production đã chốt (PLACE-037/038): https://phuquochub.com/api (path /api cùng domain,
# không dùng subdomain riêng) — dùng giá trị đó khi build image production thật.

# MVP SEO pass: metadataBase/sitemap.ts/robots.ts đều cần biết origin thật của web app — trước
# đây KHÔNG có biến nào cho việc này, nên canonical URL/OG image resolve về mặc định
# http://localhost:3000 (Next.js tự fallback + cảnh báo) ngay cả khi build production. Cùng quy
# tắc NEXT_PUBLIC_ build-time-nhúng-cứng như NEXT_PUBLIC_API_URL ở trên.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://phuquochub.com (không có dấu / cuối).

# --- Rate limiting (PLACE-028 / OD2-12) ---
# Giới hạn toàn cục (mọi endpoint trừ /api/health): RATE_LIMIT_LIMIT request / RATE_LIMIT_TTL giây.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
# Giới hạn riêng cho /api/auth/login, /api/auth/register (chống brute-force/spam).
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_LIMIT=10

# --- CORS (PLACE-028 / OD2-13) ---
# Danh sách origin được phép, phân tách bằng dấu phẩy. BẮT BUỘC khi NODE_ENV=production
# (app sẽ fail-fast khi khởi động nếu thiếu). Ở dev, mặc định http://localhost:3000.
# Production (PLACE-037/038 — domain đã chốt): https://phuquochub.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Chỉ bật true nếu frontend thực sự cần gửi cookie qua CORS — hiện tại auth dùng bearer
# token (Authorization header), không dùng cookie, nên mặc định false.
CORS_CREDENTIALS=false

# --- Reverse proxy (PLACE-028, topology finalized PLACE-038) ---
# Số hop reverse-proxy đáng tin cậy phía trước API (dùng để lấy đúng client IP cho rate
# limiting qua X-Forwarded-For). Mặc định 0 = chưa có reverse proxy thật, không tin header
# forwarded nào. docker-compose.prod.yml đặt =1 (Caddy đứng trước API, PLACE-038) — giữ 0 ở
# đây cho dev cục bộ (không có proxy nào phía trước khi chạy `npm run dev`).
TRUST_PROXY_HOPS=0

# --- Verification Expiry Schedule (ADR-008, VERIFICATION SCHEDULER — Operational Enablement, 2026-08-06) ---
# Job nền chuyển verifications đã hết hạn (verified/official/community_verified quá expires_at)
# sang expired, chạy trong tiến trình API. Mặc định TẮT ở MỌI môi trường (kể cả production) —
# bật lịch chạy PHẢI là một quyết định vận hành tường minh, không suy luận ngầm từ NODE_ENV.
# Chi tiết: docs/architecture/deployment.md §8/§12.4b,
# docs/delivery/reports/VERIFICATION-SCHEDULER-OPERATIONAL-ENABLEMENT-2026-08-06.md.
VERIFICATION_EXPIRY_SCHEDULE_ENABLED=false
# Cron 6-trường (giây phút giờ ngày tháng thứ), UTC. Mặc định mỗi 15 phút.
VERIFICATION_EXPIRY_CRON=0 */15 * * * *
# Số dòng/lô, số lô tối đa, và ngân sách thời gian tối đa (ms) mỗi lần chạy — cùng con số
# MediaCleanupService đã dùng cho job dọn dẹp tương tự.
VERIFICATION_EXPIRY_BATCH_SIZE=100
VERIFICATION_EXPIRY_MAX_BATCHES=50
VERIFICATION_EXPIRY_MAX_EXECUTION_MS=300000
