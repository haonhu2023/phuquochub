{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "PhuQuocHub config/nestjs",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "target": "ES2022"
  }
}
