# ─────────────────────────────────────────────────────────────────────────────────────────────────
# HTTP security headers (2026-08-15). Values are DERIVED FROM THIS APPLICATION, not a template.
#
# HSTS: `max-age=31536000` with NO includeSubDomains and NO preload, deliberately.
# Every subdomain in use today is HTTPS (www + media, both verified serving TLS), but the set of
# subdomains cannot be enumerated authoritatively from here, and includeSubDomains would break any
# future plain-HTTP host (staging, an ACME challenge helper) for a full year with no client-side
# remedy. Instead every host block below carries its OWN HSTS header, which gives the same coverage
# for the hosts that actually exist without betting on the ones that do not. Preload is a
# browser-baked, slow-to-reverse commitment and is a separate decision.
# ─────────────────────────────────────────────────────────────────────────────────────────────────
(hsts) {
	Strict-Transport-Security "max-age=31536000"
}

www.phuquochub.com {
	header {
		import hsts
	}
	redir https://phuquochub.com{uri} permanent
}

# Secure Private Media (87d010e) — object-storage edge for `media.phuquochub.com`.
#
# THIS BLOCK WAS MISSING FROM SOURCE CONTROL. It was configured directly on the VPS during the
# private-media rollout; a clean `docker compose up` from this repo would have produced a stack with
# NO media host at all (every image 404/NXDOMAIN). Reconciled here so the repo reproduces production.
#
# ── Why a public host in front of a PRIVATE bucket ───────────────────────────────────────────────
# The bucket (`phuquochub-prod`) is private: anonymous GET returns 403, and there is no anonymous
# list. Nothing here re-opens it. What this host serves is *presigned* URLs — SigV4-signed, short
# lived (S3_PRESIGN_GET_TTL, 300s) links minted per-request by `GET /api/media/{id}/file` only after
# the API has confirmed the media row is `published` and not soft-deleted. The signature is the
# credential; the proxy is only a reachable path to the bucket.
#
# ── CRITICAL: never rewrite the Host header ──────────────────────────────────────────────────────
# SigV4 signs the Host header. The AWS SDK signs these URLs for whatever origin `S3_ENDPOINT` names
# (production: https://media.phuquochub.com), so MinIO must receive `Host: media.phuquochub.com` to
# recompute a matching signature. Caddy's `reverse_proxy` preserves the inbound Host by default,
# which is exactly what we need — do NOT "fix" this by adding `header_up Host {upstream_hostport}`
# or similar. Doing so makes every signature mismatch and returns 403 on every image.
# For the same reason `S3_ENDPOINT` in production MUST be the public origin, not `http://minio:9000`
# — an internal endpoint would mint URLs the browser cannot resolve. See .env.example.
media.phuquochub.com, :8081 {
	# MinIO serves its ADMIN API from the same port as the S3 API (`/minio/admin/...` on :9000), so
	# proxying :9000 wholesale would publish the admin surface. It is credential-gated, but this is a
	# hard requirement, not a best-effort one — refuse the whole prefix at the edge.
	# Safe by construction: with S3_FORCE_PATH_STYLE=true every legitimate object URL is
	# `/{bucket}/{key}` = `/phuquochub-prod/media/{uuid}.{ext}`, which can never start with `/minio/`.
	# The MinIO CONSOLE is a separate listener (:9001, see docker-compose.prod.yml) and is not
	# proxied by any site block in this file — it stays unreachable from the internet.
	handle /minio/* {
		respond 404
	}

	handle {
		# Presigned PUT (upload) and presigned GET (delivery) both land here. Methods are intentionally
		# NOT filtered: uploads are browser PUTs to presigned URLs, and MinIO already rejects anything
		# without a valid signature on a private bucket. Filtering here would risk breaking the working
		# upload path for no additional guarantee.
		reverse_proxy minio:9000
	}

	# Defense in depth for user-uploaded bytes. Only image/jpeg|png|webp can ever be registered
	# (media.dto.ts allowlist, re-verified server-side against the real object), so there is no SVG
	# script vector — nosniff keeps it that way if the allowlist ever widens.
	header {
		X-Content-Type-Options nosniff
		-Server
		import hsts
		# This host serves ONLY object bytes (image/jpeg|png|webp) and MinIO's XML error documents.
		# `default-src 'none'` therefore forbids everything without forbidding anything real: an image
		# rendered as its own document needs no subresources. It is inert for the two flows that
		# matter -- a response CSP never governs the REQUEST, so presigned PUT uploads and
		# cross-origin <img> loads from phuquochub.com are both unaffected (those are governed by the
		# app host's connect-src/img-src below).
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		X-Frame-Options DENY
	}

	# No `encode gzip` here, unlike the app block below: JPEG/PNG/WebP are already compressed, so
	# re-compressing burns CPU on every image for no size win.

	log {
		output file /data/media-access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# PLACE-038 — reverse proxy for the single-VPS Topology A stack (Owner-approved PLACE-037/038).
#
# Two addresses on the SAME site block (a documented, supported Caddy pattern): the real
# production domain (automatic HTTPS via ACME once real DNS points at a real VPS -- NOT
# available in this repository/session) and a plain-HTTP local test port (`:8080`) that
# exercises the IDENTICAL routing logic for local verification, with no DNS or TLS involved.
# `:8080` is verification-only -- it is not part of the intended production surface.
phuquochub.com, :8080 {
	encode gzip

	# API traffic: everything under /api goes to the NestJS service. The API's own
	# X-Request-Id correlation middleware (PLACE-030) reads a client-supplied header if
	# present or generates one -- Caddy's reverse_proxy forwards all request headers
	# unmodified by default, so no extra directive is needed to preserve it.
	handle /api/* {
		# The API sets its OWN security headers (nosniff, X-Frame-Options: DENY,
		# Referrer-Policy: no-referrer -- verified live on /api/health). Deliberately NOT repeated
		# here: Caddy's `header` REPLACES, so restating them would silently override the app's
		# stricter choices (its `no-referrer` is right for JSON; the web app wants a looser one).
		# Only add what the API cannot know about itself -- transport security -- and strip the
		# Express fingerprint.
		header {
			import hsts
			-X-Powered-By
			-Server
		}
		reverse_proxy api:4000
	}

	# Everything else: the Next.js web app.
	handle {
		header {
			import hsts
			X-Content-Type-Options nosniff
			Referrer-Policy "strict-origin-when-cross-origin"
			# Not `no-referrer`: tile.openstreetmap.org's usage policy expects requests to be
			# attributable, and `strict-origin-when-cross-origin` sends the bare origin
			# (https://phuquochub.com) cross-origin while never leaking a path or query string.
			X-Frame-Options DENY
			# Nothing in the app calls these APIs (audited: zero references to geolocation,
			# getUserMedia, camera, microphone, payment, clipboard, Notification).
			Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

			# ── Content-Security-Policy — every directive justified against THIS build ──────────
			# script-src 'unsafe-inline': the shipped production HTML carries 7 inline <script>
			#   blocks on / and 6 on /map (Next.js flight/hydration payloads) with NO nonce
			#   attribute. Nonces would require an app-level middleware.ts, which is out of scope
			#   for a header-only change, so 'unsafe-inline' is the honest, deployable choice.
			#   NOTE this materially weakens CSP as an XSS control -- it is retained for
			#   frame-ancestors/object-src/base-uri/form-action, not as XSS defence.
			# NO 'unsafe-eval': maplibre-gl v4 was checked for eval( and new Function( -- zero
			#   occurrences in its 803 KB dist bundle -- so the map runs without it.
			# style-src 'unsafe-inline': 20 style="" attributes on / and 13 on /map (React
			#   style={{}} props, 155 in source).
			# img-src data:  -> maplibre marker/control SVG+WebP data URIs (observed in the live
			#                   network log).
			#         blob:  -> URL.createObjectURL(file) image preview in useSingleImageUpload.ts.
			#         media.phuquochub.com -> <img src="/api/media/{id}/file"> 302-redirects there.
			#         tile.openstreetmap.org -> raster map tiles.
			# connect-src media.phuquochub.com is REQUIRED and easy to miss: uploadPipeline.ts PUTs
			#   the file straight to the presigned object-storage URL from the browser. Omitting it
			#   breaks every upload while leaving the rest of the site working.
			# worker-src blob: -> maplibre-gl builds its worker via new Blob + createObjectURL;
			#   a blob: worker URL was observed loading on /map.
			# frame-ancestors/frame-src 'none': the app embeds no iframes and is not embeddable
			#   anywhere (also matches community.md BR-C7, which forbids arbitrary script/iframe
			#   embedding). Agrees with X-Frame-Options: DENY above.
			# No COOP/COEP/CORP: none is needed here, and CORP in particular would break the
			#   cross-origin media images this site depends on.
			Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://media.phuquochub.com https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://media.phuquochub.com https://tile.openstreetmap.org; worker-src 'self' blob:; manifest-src 'self'"

			# Next.js emits `X-Powered-By: Next.js` by default. Stripping it at the proxy avoids an
			# app rebuild (next.config poweredByHeader:false would need one). `Via: 1.1 Caddy` is
			# deliberately KEPT -- it is a standard, useful proxy-hop marker, not a product
			# fingerprint.
			-X-Powered-By
			-Server
		}
		reverse_proxy web:3000
	}

	# Caddy's reverse_proxy sets X-Forwarded-For/X-Forwarded-Proto/X-Forwarded-Host
	# automatically -- matches apps/api's TRUST_PROXY_HOPS=1 expectation (one proxy hop)
	# with no further configuration required here.

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
